MONGO_DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Used by FastAPI app (same value as MONGO_DB_URL)
MONGODB_URL_KEY=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Local MLflow tracking (default). For DagsHub, set all three below.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# AWS S3 artifact sync (train.py / TrainingPipeline / Docker entrypoint)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# TRAINING_BUCKET_NAME=networksecurity-mlops-safwen
# MODEL_S3_TIMESTAMP=08_14_2026_18_31_46

# GitHub Actions secrets (Settings -> Secrets and variables -> Actions)
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# AWS_REGION=us-east-1
# ECR_REPOSITORY_NAME=networksecurity-mlops
# TRAINING_BUCKET_NAME=networksecurity-mlops-safwen
# MONGO_DB_URL=<same as above>

# ECR login URI format: <account-id>.dkr.ecr.<region>.amazonaws.com
# Example: 824756206130.dkr.ecr.us-east-1.amazonaws.com
